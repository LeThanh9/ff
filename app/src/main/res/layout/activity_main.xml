<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Thanh Tiêu Đề Trên Cùng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="FREE FIRE MASTER PRO"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="#00FFCC"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <TextView
                    android:text="Hỗ Trợ Toàn Diện: Máy Không Root (No-Root), Xiaomi HyperOS &amp; Root"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#8888BB"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnDumper"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="TRÍCH XUẤT OFFSET"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#7C4DFF"
                android:paddingHorizontal="14dp"/>
        </LinearLayout>

        <!-- Thẻ Trạng Thái Hệ Thống (Root / Lớp Phủ / Trợ Năng AimDrag) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvRootStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CHẾ ĐỘ: ĐANG KIỂM TRA..."
                android:textSize="11sp"
                android:textColor="#FFCC00"
                android:fontFamily="monospace"
                android:background="#15172C"
                android:padding="8dp"
                android:gravity="center"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tvOverlayStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LỚP PHỦ: ĐANG KIỂM TRA..."
                android:textSize="11sp"
                android:textColor="#FFCC00"
                android:fontFamily="monospace"
                android:background="#15172C"
                android:padding="8dp"
                android:gravity="center"
                android:layout_marginHorizontal="4dp"/>

            <TextView
                android:id="@+id/tvAccessibilityStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TRỢ NĂNG (AIM): CHỜ..."
                android:textSize="11sp"
                android:textColor="#FFCC00"
                android:fontFamily="monospace"
                android:background="#15172C"
                android:padding="8dp"
                android:gravity="center"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Khối Thiết Lập Nhanh Cho Máy No-Root & Xiaomi HyperOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141933"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:text="⚡ CẤU HÌNH NHANH (MÁY NO-ROOT &amp; XIAOMI HYPEROS)"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00FFCC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:text="1. Vuốt Kéo Tâm Không Root (No-Root): Sử dụng dịch vụ Trợ Năng (Accessibility Gesture) chuẩn Google Android giúp vuốt tâm mượt mà 100% không cần can thiệp Root.\n2. Xiaomi HyperOS / MIUI: Bắt buộc bật 'Hiển thị cửa sổ pop-up khi chạy dưới nền' và 'Bỏ qua tối ưu pin' để menu không bị hệ thống tắt khi vào game.\n3. Nếu Android 13/14 báo 'Cài đặt bị hạn chế' (Restricted Setting): Vào Thông tin ứng dụng -> Bấm dấu 3 chấm góc trên bên phải -> Chọn 'Cho phép cài đặt bị hạn chế'."
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C5D0F0"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOpenAccessibility"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="BẬT TRỢ NĂNG AIM"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0088FF"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnXiaomiPerm"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="QUYỀN HYPEROS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#0A0B14"
                    android:backgroundTint="#FFB300"
                    android:layout_marginHorizontal="4dp"/>

                <Button
                    android:id="@+id/btnIgnoreBattery"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="TẮT TỐI ƯU PIN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2E7D32"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Thẻ Cấu Hình Chức Năng Ban Đầu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111322"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:text="CẤU HÌNH BAN ĐẦU"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00FFCC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp"/>

            <Switch
                android:id="@+id/switchESP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lớp phủ ESP (Khung xương, Khung hộp, Máu, Snapline, Khoảng cách)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:checked="true"
                android:paddingVertical="8dp"/>

            <Switch
                android:id="@+id/switchAimbot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kéo Tâm &amp; Tự Động Khóa Cổ (Vòng FOV Chuẩn Headshot)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:checked="true"
                android:paddingVertical="8dp"/>

            <!-- Proxy & Fake Lag Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#15172C"
                android:padding="14dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:text="MẠNG PROXY &amp; TẠO ĐỘ TRỄ (FAKE LAG)"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#00FFCC"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvProxyInfo"
                    android:text="Proxy SOCKS5/TCP: 127.0.0.1:8888 [ĐÃ TẮT]"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#8888AA"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp"/>

                <Switch
                    android:id="@+id/switchFakeLag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bật Proxy Fake Lag (Mô phỏng trễ 127.0.0.1:8888)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:checked="false"
                    android:paddingVertical="4dp"/>

                <TextView
                    android:id="@+id/tvLagValue"
                    android:text="Độ trễ Fake Lag: 150 ms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#00FFCC"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="8dp"/>

                <SeekBar
                    android:id="@+id/sbFakeLag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="950"
                    android:progress="100"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"/>

                <Switch
                    android:id="@+id/switchRootNetem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kernel Netem (Chỉ áp dụng khi thiết bị đã Root)"
                    android:textColor="#FFCC00"
                    android:textSize="12sp"
                    android:checked="false"
                    android:paddingVertical="4dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Thẻ Chế Độ An Toàn Chạy Ngầm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141933"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:text="🛡️ CHẾ ĐỘ CHẠY NGẦM AN TOÀN"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#00FF66"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvPatchStatus"
                    android:text="GAME NGUYÊN BẢN ✓"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#00FF66"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="#2000FF66"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"/>
            </LinearLayout>

            <TextView
                android:text="✓ An Toàn Tuyệt Đối: Ứng dụng chạy lớp phủ ngầm (Overlay) và Dịch vụ Trợ Năng cảm ứng, KHÔNG can thiệp, KHÔNG ghi đè bất kỳ file nào vào thư mục game, tránh 100% việc bị Garena quét hash file và khóa nick!"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C5D0F0"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="12dp"/>

            <!-- Nút dọn dẹp / khôi phục game gốc -->
            <Button
                android:id="@+id/btnRemovePatch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🧹 DỌN DẸP / GỠ BỎ FILE VÁ (CHỐNG BAN)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF4444"
                android:layout_marginBottom="10dp"/>

            <Switch
                android:id="@+id/switchAntiBanFirewall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tường lửa Chặn Máy Chủ Quét Garena (Anti-Ban)"
                android:textColor="#FFCC00"
                android:textSize="12sp"
                android:checked="false"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <!-- Hộp Hiển Thị Trạng Thái Hoạt Động -->
        <TextView
            android:id="@+id/tvStatus"
            android:text="Trạng thái: CHỜ LỆNH (Sẵn sàng kích hoạt)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="10dp"
            android:background="#0E101D"
            android:layout_marginBottom="16dp"/>

        <!-- Hàng Nút Hành Động 1: KÍCH HOẠT & HIỂN THỊ MENU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnInject"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="BẮT ĐẦU KÍCH HOẠT"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00CC66"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnShowMenu"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="HIỂN THỊ MENU NỔI"
                android:textStyle="bold"
                android:textColor="#0A0B14"
                android:backgroundTint="#00FFCC"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

        <!-- Hàng Nút Hành Động 2: DỪNG TẤT CẢ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="DỪNG TẤT CẢ (HỆ THỐNG + MENU + PROXY)"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D50000"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
